dist
node_modules
*.svg

# pnpm writes this in its own format on every install; formatting it here only
# starts a fight Prettier loses on the next lockfile change.
pnpm-lock.yaml

# DocC catalogs are Markdown-shaped but not Markdown: Prettier flattens the
# double-backtick symbol links and directive blocks that DocC depends on.
*.docc

# SwiftPM's build directory: vendored, read-only checkouts of other people's
# sources. Git ignores it via generate-navaids/.gitignore, which Prettier
# doesn't read because it only consults the root .gitignore.
generate-navaids/.build

# SwiftLint's cache of the shared config it fetches from a gist, written in
# whatever shape SwiftLint pleases. Ignored via generate-navaids/.gitignore for
# the same reason as .build above.
generate-navaids/.swiftlint

# Wire-format data written by generate-navaids: parallel arrays the browser
# fetches on every visit. Formatting it for human eyes would undo the point of
# the shape. The second path is the generator's own working copy, left behind in
# generate-navaids after a run and ignored there by its nested .gitignore.
public/ndbs.json
generate-navaids/ndbs.json
