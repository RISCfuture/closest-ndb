{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "project": ["src/**/*.{ts,vue}"],
  "entry": ["src/**/__tests__/*.spec.ts"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@flydotio/dockerfile",
    "@types/setimmediate",
    "@vitest/browser",
    "@vue/compiler-core",
    "motion",
    "setimmediate",
    "stylelint-config-recommended-scss"
  ],
  "rules": {
    "exports": "error"
  }
}
