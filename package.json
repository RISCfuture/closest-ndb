{
  "name": "closest-ndb",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build",
    "dev": "vite",
    "doc": "typedoc --out docs src --skipErrorChecking",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm run lint:eslint && pnpm run lint:oxlint && pnpm run lint:stylelint && pnpm run lint:knip",
    "lint:eslint": "eslint .",
    "lint:oxlint": "oxlint -c oxlintrc.json src",
    "lint:knip": "knip",
    "lint:stylelint": "stylelint \"src/**/*.{vue,css,scss,sass}\" \"public/*.css\"",
    "preview": "vite preview",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:dev": "playwright test --ui",
    "test:unit": "vitest",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@intlify/core-base": "^11.4.16",
    "@sentry/vue": "^11.10.0",
    "@vueuse/core": "^15.0.0",
    "lodash-es": "^4.18.1",
    "normalize.css": "^8.0.1",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@flydotio/dockerfile": "^0.7.15",
    "@opentelemetry/api": "^1.10.0",
    "@pinia/testing": "^2.0.2",
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.6.6",
    "@types/setimmediate": "^1.0.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vue/compiler-core": "^3.5.44",
    "@vue/compiler-dom": "^3.5.44",
    "@vue/server-renderer": "^3.5.44",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "knip": "^6.44.1",
    "oxlint": "^1.90.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.32",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "setimmediate": "^1.0.5",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.9.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.2",
    "typedoc": "^0.28.20",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vite-plugin-csp-guard": "^4.0.1",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.5",
    "vitest-browser-vue": "^3.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14"
  },
  "packageManager": "pnpm@12.16.1"
}
